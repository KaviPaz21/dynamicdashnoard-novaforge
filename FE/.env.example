# Base URL of the NovaForge FastAPI backend (BE/). Must include the /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:8001/api

# Public half of the server's signing key (printed into FE/.env.local by BE/scripts/gen_secrets.py). The browser refuses to
# talk to a server that cannot prove it holds the matching private key. Leave unset only for throwaway local experiments.
NEXT_PUBLIC_SECURE_SIGNING_PUBKEY=
