# ---------------------------------------------------------------------------
# NovaForge backend configuration. Copy to .env and fill in the values.
# ---------------------------------------------------------------------------

# --- API ---------------------------------------------------------------
API_PREFIX=/api
# Comma separated list of origins allowed to call the API (the Next.js app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Azure Cosmos DB (NoSQL API) --------------------------------------------
# Leave COSMOS_ENDPOINT empty to use the in-memory store (dev/demo only, data
# is lost on restart). For the local emulator use https://localhost:8081 and
# the emulator's well-known key, with COSMOS_VERIFY_SSL=false.
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=novaforge
COSMOS_VERIFY_SSL=true
COSMOS_WRITE_CONCURRENCY=32

# --- LLM ---------------------------------------------------------------------
# Azure OpenAI / AI Foundry: LLM_BASE_URL is the resource root (no path), e.g.
#   https://<resource>.openai.azure.com/
# and LLM_MODEL is the *deployment name*. Any other URL is treated as a plain
# OpenAI-compatible endpoint (chat completions).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_API_VERSION=2025-04-01-preview
# true = call /openai/responses (Responses API); false = chat completions on the deployment
LLM_USE_RESPONSES_API=true
# Leave unset unless your model accepts a temperature parameter.
# LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120

# --- Embeddings (used by the document RAG pipeline) -------------------------------
# Falls back to LLM_BASE_URL / LLM_API_KEY when left empty.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Azure: the embedding *deployment name*
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_VERSION=2023-05-15
# Must match the model output size (text-embedding-3-small=1536, text-embedding-3-large=3072).
# It is baked into the Cosmos vector policy when the `chunks` container is first created.
EMBEDDING_DIMENSIONS=1536

# --- Ingestion / retrieval tuning -----------------------------------------------------
MAX_UPLOAD_MB=50
MAX_ROWS_PER_DATASET=50000
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=6

# --- Domain framing injected into the agents' system prompts ------------------------------
DOMAIN_CONTEXT=NASA Space Apps 2026 challenge: NASA has studied how flames and fire behave in microgravity for decades. Help users find, compare, rank and interpret those experimental findings so they yield fire safety insights for human space exploration (Moon and Mars missions).
